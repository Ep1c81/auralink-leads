# Configuración del servidor. Nunca copiar secretos a NEXT_PUBLIC_*.
APP_ORIGIN=https://crm.example.com
SUPABASE_URL=https://project.example.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REEMPLAZAR_EN_EL_SERVIDOR
NEXT_PUBLIC_SUPABASE_URL=https://project.example.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REEMPLAZAR_CON_CLAVE_PUBLICA
# Cuentas invitadas previamente en Supabase Auth; separadas por coma.
OPERATOR_EMAILS=operador@example.com
OPERATOR_IDS=
CRON_SECRET=REEMPLAZAR_EN_EL_SERVIDOR
SHIELDY_INGEST_SECRET=REEMPLAZAR_EN_EL_SERVIDOR
META_APP_SECRET=REEMPLAZAR_EN_EL_SERVIDOR
WHATSAPP_VERIFY_TOKEN=REEMPLAZAR_EN_EL_SERVIDOR
OUTREACH_AUTOMATION_SECRET=REEMPLAZAR_EN_EL_SERVIDOR
OUTREACH_STATUS_SECRET=REEMPLAZAR_EN_EL_SERVIDOR
MAKE_RECEIPT_SECRET=REEMPLAZAR_EN_EL_SERVIDOR
MAKE_DISPATCH_WEBHOOK_URL=https://hook.example.com/REEMPLAZAR
MAKE_CONTRACT_VERIFIED=false
# IA opcional; primero usar el scoring heurístico y los borradores determinísticos.
AI_ENABLED=false
AI_DAILY_CALL_LIMIT=10
ANTHROPIC_API_KEY=
GOOGLE_PLACES_API_KEY=
# Alertas al operador: deshabilitadas hasta validar destino y plantilla.
OPERATOR_ALERTS_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_ALERT_TO=
