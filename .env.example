# Server-side (API routes, src/lib/supabase.ts). Never exposed to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional fallback read by src/lib/supabase.ts if SUPABASE_URL/
# SUPABASE_SERVICE_ROLE_KEY are unset. Not required: src/app/dashboard and all
# API routes go through the server (service-role client), never the browser,
# so nothing currently ships an anon key to the client. Only needed if you add
# a client component that talks to Supabase directly — in that case, only put
# the anon/publishable key here, never the service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

GEMINI_API_KEY=

# Optional: WhatsApp alerts via the Meta Cloud API.
# If any of these are unset, qualified-lead alerts are logged to the console instead.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_ALERT_TO=

# Required to verify the WhatsApp inbound webhook (src/app/api/webhooks/whatsapp).
# Set this to the same value you enter as "Verify token" in the Meta App dashboard.
WHATSAPP_VERIFY_TOKEN=

# Required for lead prospecting (src/app/api/prospecting). A Google Cloud API key
# with the Places API (New) enabled: https://console.cloud.google.com/apis/library/places.googleapis.com
GOOGLE_PLACES_API_KEY=

# Optional: one-sentence description of what you're selling, used to ground the
# Gemini-generated outreach templates (src/lib/outreach.ts). If unset, defaults to
# a generic "WhatsApp engagement + digital visibility for local CR businesses" pitch.
OUTREACH_OFFERING_DESCRIPTION=

# Required to enable the scheduled auto-prospect sweep (src/app/api/cron/sweep).
# Set this to a long random string, and add the same value as an environment
# variable in your Vercel project. Vercel Cron Jobs then automatically send it
# as `Authorization: Bearer <CRON_SECRET>` on every scheduled invocation — the
# route rejects any request without a matching header, so leaving this unset
# disables the cron route entirely rather than leaving it open.
CRON_SECRET=

# Outreach module (src/app/outreach, src/lib/outreachCampaigns.ts).
# Webhook n8n watches for outreach_messages that just moved to "queued";
# n8n sends the actual email via Resend (built separately, not in this repo).
# Leaving this unset queues messages without notifying n8n.
N8N_OUTREACH_WEBHOOK=

# Shared secret n8n must send as `x-outreach-secret` when it calls
# /api/outreach-status to report a send result. Leaving this unset disables
# the endpoint entirely rather than leaving it open.
OUTREACH_STATUS_SECRET=

# Automated WhatsApp sequence via Make.com (src/lib/outreachAutomation.ts).
# Make.com "Custom webhook" URL that receives each batch from
# /api/outreach/dispatch and /api/outreach/followup-check as
# { sequence_stage, count, leads: [{ lead_id, phone, business_name, canton, template_text, sequence_stage }] }.
MAKE_DISPATCH_WEBHOOK_URL=

# Shared secret Make.com must send as `Authorization: Bearer <secret>` to
# /api/outreach/dispatch, /api/outreach/followup-check and
# /api/webhooks/make-reply. Leaving this unset disables all three routes.
OUTREACH_AUTOMATION_SECRET=
